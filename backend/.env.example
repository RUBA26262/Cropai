# Database — use SQLite for quick local dev, switch to Postgres for production
DATABASE_URL=sqlite:///./cropai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cropai

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENWEATHER_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# "mock" until a trained model is plugged into app/ml/model.py
ML_MODE=mock
